# Copy to vault.yml, fill in real values, then encrypt before committing:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
# vault.yml itself is gitignored and must never be committed unencrypted.

vault_xui_admin_username: admin
vault_clients:
    alice:
        uuid: CHANGE_ME
        sub_id: CHANGE_ME
    bob:
        uuid: CHANGE_ME
        sub_id: CHANGE_ME
    default:
        uuid: CHANGE_ME
        sub_id: CHANGE_ME
vault_nodes:
    example-node:
        admin_password: CHANGE_ME
        api_token: CHANGE_ME
        web_base_path: CHANGE_ME
        reality_private_key: CHANGE_ME
        reality_public_key: CHANGE_ME
        reality_short_ids:
            - CHANGE_ME
vault_relay_clients:
    example-hop:
        uuid: CHANGE_ME
